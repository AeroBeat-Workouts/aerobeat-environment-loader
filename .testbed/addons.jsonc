{
  "$schema": "https://chickensoft.games/schemas/addons.schema.json",
  "addons": {
    // The loader consumes the shared environment contract package.
    // `main` is intentional until aerobeat-environment-core starts tagging releases.
    "aerobeat-environment-core": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-environment-core.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Video playback now composes the shared video stack instead of owning a direct one-off path.
    "aerobeat-tool-core": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-core.git",
      "checkout": "main",
      "subfolder": "/"
    },
    "aerobeat-tool-video-player": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-video-player.git",
      "checkout": "main",
      "subfolder": "/"
    },
    "aerobeat-vendor-godot-video": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-vendor-godot-video.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // GLB loading now composes the shared GLTF tool facade plus its current vendor backend.
    "aerobeat-tool-gltf": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-gltf.git",
      "checkout": "main",
      "subfolder": "/"
    },
    "aerobeat-vendor-godot-gltf": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-vendor-godot-gltf.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // GUT drives the repo-local test suite inside the hidden testbed/workbench.
    "gut": {
      "url": "git@github.com:bitwes/Gut.git",
      "checkout": "main",
      "subfolder": "/addons/gut"
    }
  }
}
